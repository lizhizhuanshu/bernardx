guards: # when 包装三形态
  g1: when bb flag exists until see "**/A" click "**/A"
  g2: when (see "**/A" or see "**/B") wait 100ms
  g3[retry=1]: when not in_app "com.x" until in_app "com.x" open_app "com.x"
  g4: when bb done == 1:
    inner: wait 50ms
  g5: when see "**/X" and count "**/Y" >= 2:
    i1: replace_text value="hi"
  g6[retry=[2,3], timeout=[4000,6000]ms]: until see "**/Z" and not see "**/W":
    i2: wait 10ms
    i3: click "**/Z"
