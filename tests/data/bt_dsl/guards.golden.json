{
  "type": "Pipeline",
  "name": "guards",
  "description": "when 包装三形态",
  "children": [
    {
      "type": "Script",
      "name": "g1",
      "source": "actions/click.lua",
      "params": {
        "desc": "**/A",
        "by": "class_chain"
      },
      "condition": {
        "type": "Blackboard",
        "params": {
          "key": "flag",
          "op": "exists"
        }
      },
      "*target": {
        "type": "Script",
        "source": "conds/see.lua",
        "params": {
          "by": "class_chain",
          "desc": "**/A"
        }
      }
    },
    {
      "type": "Wait",
      "name": "g2",
      "params": {
        "timeout": 100
      },
      "condition": {
        "type": "Or",
        "children": [
          {
            "type": "Script",
            "source": "conds/see.lua",
            "params": {
              "by": "class_chain",
              "desc": "**/A"
            }
          },
          {
            "type": "Script",
            "source": "conds/see.lua",
            "params": {
              "by": "class_chain",
              "desc": "**/B"
            }
          }
        ]
      }
    },
    {
      "type": "Script",
      "name": "g3",
      "source": "actions/open_app.lua",
      "params": {
        "package_name": "com.x"
      },
      "condition": {
        "type": "Not",
        "child": {
          "type": "Script",
          "source": "conds/in_app.lua",
          "params": {
            "package_name": "com.x"
          }
        }
      },
      "*target": {
        "type": "Script",
        "source": "conds/in_app.lua",
        "params": {
          "package_name": "com.x"
        }
      },
      "*retry": 1
    },
    {
      "type": "Pipeline",
      "name": "g4",
      "children": [
        {
          "type": "Wait",
          "name": "inner",
          "params": {
            "timeout": 50
          }
        }
      ],
      "condition": {
        "type": "Blackboard",
        "params": {
          "key": "done",
          "op": "==",
          "value": 1
        }
      }
    },
    {
      "type": "Pipeline",
      "name": "g5",
      "children": [
        {
          "type": "Script",
          "name": "i1",
          "source": "actions/ime_action.lua",
          "params": {
            "action": "input",
            "value": "hi"
          }
        }
      ],
      "condition": {
        "type": "And",
        "children": [
          {
            "type": "Script",
            "source": "conds/see.lua",
            "params": {
              "by": "class_chain",
              "desc": "**/X"
            }
          },
          {
            "type": "Script",
            "source": "conds/node_target_count.lua",
            "params": {
              "by": "class_chain",
              "desc": "**/Y",
              "op": ">=",
              "value": 2
            }
          }
        ]
      }
    },
    {
      "type": "Pipeline",
      "name": "g6",
      "children": [
        {
          "type": "Wait",
          "name": "i2",
          "params": {
            "timeout": 10
          }
        },
        {
          "type": "Script",
          "name": "i3",
          "source": "actions/click.lua",
          "params": {
            "desc": "**/Z",
            "by": "class_chain"
          }
        }
      ],
      "*target": {
        "type": "And",
        "children": [
          {
            "type": "Script",
            "source": "conds/see.lua",
            "params": {
              "by": "class_chain",
              "desc": "**/Z"
            }
          },
          {
            "type": "Not",
            "child": {
              "type": "Script",
              "source": "conds/see.lua",
              "params": {
                "by": "class_chain",
                "desc": "**/W"
              }
            }
          }
        ]
      },
      "params": {
        "retry": [
          2,
          3
        ],
        "timeout": [
          4000,
          6000
        ]
      }
    }
  ]
}
